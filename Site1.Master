<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="ForteLogisticsApp.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Logisticore Courier Service</title>
    <link rel="icon" type="image/jpeg" href="<%= ResolveUrl("~/Images/logisticore-logo.jpg") %>" />

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Typography: Hanken Grotesk (headlines) + Inter (body/labels), per LogistiCore V5 -->
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <!-- Material Symbols Outlined (icon system) -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- JsBarcode (Code128 barcode rendering) -->
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>

    
    <!-- External Fonts & Scripts -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>

    <!-- Tailwind Config -->
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    "colors": {
                        "error-container": "#ffdad6",
                        "inverse-on-surface": "#f0f0f3",
                        "on-background": "#1a1c1e",
                        "primary-fixed-dim": "#b5c4ff",
                        "tertiary-fixed-dim": "#e1b6ff",
                        "surface-tint": "#3557bc",
                        "surface-dim": "#dadadc",
                        "inverse-surface": "#2f3133",
                        "on-surface": "#1a1c1e",
                        "on-secondary-fixed-variant": "#8e004b",
                        "on-tertiary-container": "#cb8ef8",
                        "error": "#ba1a1a",
                        "primary": "#002068",
                        "secondary-fixed-dim": "#ffb0c9",
                        "on-tertiary-fixed-variant": "#632a8e",
                        "on-primary-fixed": "#00164e",
                        "on-primary": "#ffffff",
                        "outline": "#747684",
                        "on-primary-fixed-variant": "#153ea3",
                        "on-error": "#ffffff",
                        "surface-variant": "#e2e2e5",
                        "tertiary": "#3f0067",
                        "inverse-primary": "#b5c4ff",
                        "on-surface-variant": "#444653",
                        "surface-container": "#eeeef0",
                        "on-tertiary-fixed": "#2e004d",
                        "primary-container": "#003399",
                        "secondary-fixed": "#ffd9e2",
                        "on-secondary": "#ffffff",
                        "on-error-container": "#93000a",
                        "tertiary-container": "#581e83",
                        "outline-variant": "#c4c5d5",
                        "secondary": "#b50062",
                        "tertiary-fixed": "#f2daff",
                        "on-secondary-container": "#fffbff",
                        "surface": "#f9f9fc",
                        "on-secondary-fixed": "#3e001e",
                        "surface-container-high": "#e8e8ea",
                        "primary-fixed": "#dce1ff",
                        "on-tertiary": "#ffffff",
                        "background": "#f9f9fc",
                        "surface-bright": "#f9f9fc",
                        "surface-container-low": "#f3f3f6",
                        "on-primary-container": "#8aa4ff",
                        "surface-container-highest": "#e2e2e5",
                        "surface-container-lowest": "#ffffff",
                        "secondary-container": "#e2007c"
                    },
                    "borderRadius": {
                        "DEFAULT": "0.125rem",
                        "lg": "0.25rem",
                        "xl": "0.5rem",
                        "full": "0.75rem"
                    },
                    "spacing": {
                        "margin-mobile": "16px",
                        "gutter": "24px",
                        "container-max": "1280px",
                        "base": "8px",
                        "stack-sm": "12px",
                        "stack-md": "24px",
                        "margin-desktop": "40px",
                        "stack-lg": "48px"
                    },
                    "fontFamily": {
                        "headline-lg-mobile": ["Hanken Grotesk"],
                        "headline-xl": ["Hanken Grotesk"],
                        "label-md": ["Inter"],
                        "headline-lg": ["Hanken Grotesk"],
                        "body-md": ["Inter"],
                        "headline-md": ["Hanken Grotesk"],
                        "label-sm": ["Inter"],
                        "body-lg": ["Inter"]
                    },
                    "fontSize": {
                        "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "headline-xl": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
                        "label-md": ["14px", { "lineHeight": "20px", "fontWeight": "600" }],
                        "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
                        "body-md": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
                        "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
                        "label-sm": ["12px", { "lineHeight": "16px", "fontWeight": "500" }],
                        "body-lg": ["18px", { "lineHeight": "28px", "fontWeight": "400" }]
                    }
                }
            }
        }
    </script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-background text-on-background antialiased flex h-screen overflow-hidden">
    <form id="form1" runat="server" class="flex w-full h-full">
        <!-- SideNavBar -->
        <nav class="bg-surface-container-lowest h-screen w-64 fixed left-0 top-0 border-r border-outline-variant shadow-sm flex flex-col p-stack-md space-y-2 hidden md:flex z-50">
            <div class="mb-stack-md">
                <span class="font-headline-md text-headline-md font-bold text-primary">LogistiCore</span>
                <div class="mt-base flex items-center gap-base">
                    <img alt="User Profile" class="w-8 h-8 rounded-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDAA86tJviKdr7fwBlSxpHc4c61qK0h1quaSdBIYpETi0wHbs_55-tiJmdNg7MEmn1YngYyUa1i50V_AWPwIgeQ5RgGlvZxCwW9N8qd_hKlX7ALSYUJNdv2wUfjNcjASBgpn4yKkm9LNk3467d0npVkrQ6SOHQ7xtIM61njQAVnNYRp7BDauxZse1NvQ6mjQ3b1pCdihVyZrqhoyfV-zFjmYxZ0PaJDh5toByYKaf4vbmIQbZXOpvfG"/>
                    <div>
                        <p class="font-label-md text-label-md text-on-surface" id="nav-user-name">
                            <asp:Literal ID="litNavUserName" runat="server" Text="LogistiCore Admin"></asp:Literal>
                        </p>
                        <p class="font-label-sm text-label-sm text-on-surface-variant" id="nav-user-type">
                            <asp:Literal ID="litNavUserType" runat="server" Text="Enterprise Account"></asp:Literal>
                        </p>
                    </div>
                </div>
            </div>
            
            <div class="flex-1 space-y-1">
                <a class="flex items-center gap-base p-2 bg-primary-container text-on-primary-container font-bold rounded-lg hover:bg-surface-variant transition-all focus:ring-2 focus:ring-primary-fixed duration-200" href="ClientDashboard.aspx">
                    <span class="material-symbols-outlined">dashboard</span>
                    <span class="font-label-md text-label-md">Dashboard</span>
                </a>
                <a class="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all focus:ring-2 focus:ring-primary-fixed duration-200" href="#">
                    <span class="material-symbols-outlined">local_shipping</span>
                    <span class="font-label-md text-label-md">Shipments</span>
                </a>
                <a class="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all focus:ring-2 focus:ring-primary-fixed duration-200" href="#">
                    <span class="material-symbols-outlined">analytics</span>
                    <span class="font-label-md text-label-md">Reports</span>
                </a>

                <%-- Employee Account Governance Option (Only visible to WarehouseAdmin) --%>
                <% if (Session["UserType"] != null && Session["UserType"].ToString() == "WarehouseAdmin") { %>
                <a class="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all focus:ring-2 focus:ring-primary-fixed duration-200" href="WarehouseDashboard.aspx#admin-governance">
                    <span class="material-symbols-outlined">admin_panel_settings</span>
                    <span class="font-label-md text-label-md">Account Governance</span>
                </a>
                <% } %>

                <a class="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all focus:ring-2 focus:ring-primary-fixed duration-200" href="#">
                    <span class="material-symbols-outlined">settings</span>
                    <span class="font-label-md text-label-md">Settings</span>
                </a>
            </div>

            <div class="mt-auto space-y-1 pt-stack-md border-t border-outline-variant">
                <asp:Button ID="btnCreateOrderNav" runat="server" Text="Create Order" CssClass="w-full bg-primary text-on-primary font-label-md text-label-md py-2 rounded-DEFAULT hover:bg-on-primary-fixed-variant transition-colors mb-stack-sm cursor-pointer" OnClick="btnCreateOrder_Click" />
                <a class="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all" href="#">
                    <span class="material-symbols-outlined">help</span>
                    <span class="font-label-md text-label-md">Help Center</span>
                </a>
                <asp:LinkButton ID="btnLogout" runat="server" OnClick="btnLogout_Click" CssClass="flex items-center gap-base p-2 text-on-surface-variant hover:bg-surface-variant rounded-lg transition-all w-full text-left">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="font-label-md text-label-md">Logout</span>
                </asp:LinkButton>
            </div>
        </nav>

        <!-- Main Content Canvas -->
        <main class="flex-1 ml-0 md:ml-64 overflow-y-auto p-margin-mobile md:p-margin-desktop relative h-full">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </main>
    </form>
</body>
</html>
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Same local dev connection string as the main app's Web.config, so the DB-dependent
       tests in this project (see DbTestHelper) resolve dbo.[Logisticore] the same way the
       website does. Point this at your own SQL Server instance if it differs. -->
  <connectionStrings>
    <add name="Logisticore"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=Logisticore;Integrated Security=True;Encrypt=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>

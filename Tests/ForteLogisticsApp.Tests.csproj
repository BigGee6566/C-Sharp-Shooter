<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>ForteLogisticsApp.Tests</RootNamespace>
    <AssemblyName>ForteLogisticsApp.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- The app project's own AssemblyInfo.cs sets these attributes; without this, building
         both together throws CS0579 (duplicate assembly attribute) since MSBuild.exe builds
         the whole solution's dependency graph in one process. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.2.2" />
    <PackageReference Include="MSTest.TestFramework" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- SecurePage derives from System.Web.UI.Page - the app project (net48, non-SDK) pulls
         this in implicitly, but an SDK-style project must reference it explicitly. -->
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FortCarrier&amp;Logistics.csproj" />
  </ItemGroup>

</Project>

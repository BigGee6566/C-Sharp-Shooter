<?xml version="1.0" encoding="utf-8"?>
<!--
  Logisticore Courier Service

  Database: SQL Server Express, catalog "Logisticore".
  Create it manually by running App_Data\Schema.sql in SSMS / Visual Studio
  (connected to .\SQLEXPRESS). The app also self-populates an empty Logisticore
  database on first run via Global.asax -> DbInitializer.

  If your SQL Express instance name differs, change the Data Source below
  (e.g. Data Source=. for a default instance).

  Seeded login accounts (email / password):
    admin@fcl.co.za      / Admin@123     (System Administrator)
    manager@fcl.co.za    / Manager@123   (Operations Manager)
    dispatch@fcl.co.za   / Dispatch@123  (Dispatch Controller)
    warehouse@fcl.co.za  / Warehouse@123 (Warehouse / Sorting Staff)
    driver@fcl.co.za     / Driver@123    (Delivery Driver)
    finance@fcl.co.za    / Finance@123   (Accounting / Finance Staff)
    customer@fcl.co.za   / Customer@123  (Customer)
  -->
<configuration>
  <appSettings>
    <!--
      ASP.NET 4.5+ defaults validators to "unobtrusive" mode, which requires a registered
      jQuery ScriptResourceMapping and throws at runtime on any page holding a validator.
      This app deliberately has no jQuery dependency, so use the built-in validation script
      instead - it ships with the framework and works offline.
    -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>
  <connectionStrings>
    <add name="Logisticore"
         connectionString="Data Source=LAPTOP-B5HU784A\SQLEXPRESS;Initial Catalog=Logisticore;Integrated Security=True;Encrypt=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />

    <!-- enableVersionHeader: stop advertising the ASP.NET version to attackers.
         requestValidationMode 4.5 keeps request validation active for every request. -->
    <httpRuntime targetFramework="4.8"
                 enableVersionHeader="false"
                 requestValidationMode="4.5"
                 maxRequestLength="4096" />

    <sessionState mode="InProc" timeout="20" cookieless="false" />

    <!--
      A detailed error page is how an attacker turns a blind SQL injection attempt into a
      readable one - it echoes the failing statement, table names and column names. Errors
      are now generic for remote users; full detail is still shown on the local machine
      while developing.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/AccessDenied.aspx" />
      <error statusCode="404" redirect="~/Error.aspx" />
    </customErrors>

    <!-- Session cookie is not readable from JavaScript, so an XSS bug cannot steal a session. -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" />

    <!--
      ViewState is signed and encrypted, so a client cannot tamper with posted state.
      The keys are fixed rather than auto-generated: auto-generated keys are regenerated
      on every application restart, which would invalidate in-flight ViewState and log
      users out mid-task. Treat these as a secret - regenerate them for a real deployment.
    -->
    <machineKey validation="HMACSHA256" decryption="AES"
                validationKey="4F3C9C8846B7D41DD5687B36D98B9C18380E9D935B9F35A5EF057275444FA00711A69DA96A0E732DE5AA8C1D60AF550B397E21D73F7E01AC9D92F114CA190719"
                decryptionKey="F0CF723CF65EBBFC2F65373F772C491EA14CCC21C6D08DA22E7D0EBC97937191" />

    <pages enableViewStateMac="true" viewStateEncryptionMode="Always" enableEventValidation="true">
      <namespaces>
        <add namespace="System" />
        <add namespace="ForteLogisticsApp.Services" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <!-- Reduce the blast radius of any HTML that does slip through encoding. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
        <add name="X-XSS-Protection" value="0" />
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>
</configuration>
